cat > /etc/gitconfig << EOF

[user]
        email = x
        name = xx
[alias]
        st = status
        lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
        ci = commit -m
        co = checkout
        br = branch

[core]
        quotepath = false
        safecrlf = false
        autocrlf = false
        safecrlf=warn
EOF

git config --global -e
