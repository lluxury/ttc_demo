### 二、 Terraform 构建代码 (IaC)

以下代码涵盖：**清理/替换 Target Group**、**配置 IRSA**、**Helm 安装 AWS LBC**。

```hcl
# 1. 获取现有 ALB 和 VPC 信息
data "aws_lb" "existing_alb" {
  arn = "arn:aws:elasticloadbalancing:region:account-id:loadbalancer/app/your-alb-name/xxx"
}

data "aws_vpc" "eks_vpc" {
  id = "vpc-xxxxxxxxx" # 你的 VPC ID
}

data "aws_eks_cluster" "eks" {
  name = "your-eks-cluster-name"
}

# 2. 创建用于 EKS Pod 的新 Target Group (注意: 必须是 IP 模式)
resource "aws_lb_target_group" "eks_tg" {
  name        = "tg-eks-app"
  port        = 80
  protocol    = "HTTP"
  vpc_id      = data.aws_vpc.eks_vpc.id
  target_type = "ip" # 关键：EKS Pod IP 直连模式

  health_check {
    path                = "/healthz"
    protocol            = "HTTP"
    matcher             = "200"
    interval            = 15
    timeout             = 5
    healthy_threshold   = 2
    unhealthy_threshold = 2
  }

  tags = {
    Environment = "prod"
  }
}

# 3. 将现有的 ALB 监听器规则指向新的 Target Group (替换掉原先的 EC2 TG)
resource "aws_lb_listener_rule" "app_rule" {
  listener_arn = "arn:aws:elasticloadbalancing:region:account-id:listener/app/your-alb-name/xxx/yyy" # 现有 Listener ARN
  priority     = 100

  action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.eks_tg.arn
  }

  condition {
    path_pattern {
      values = ["/*"]
    }
  }
}

# 4. 创建 AWS Load Balancer Controller 的 IRSA (IAM Role for Service Account)
module "lb_controller_irsa" {
  source  = "terraform-aws-modules/iam/aws//modules/iam-role-for-service-accounts-eks"
  version = "~> 5.30"

  role_name                              = "aws-load-balancer-controller"
  attach_load_balancer_controller_policy = true

  oidc_providers = {
    main = {
      provider_arn               = data.aws_eks_cluster.eks.identity[0].oidc[0].issuer
      namespace_service_accounts = ["kube-system:aws-load-balancer-controller"]
    }
  }
}

# 5. Helm 部署 AWS Load Balancer Controller
resource "helm_release" "aws_lb_controller" {
  name       = "aws-load-balancer-controller"
  repository = "https://aws.github.io/eks-charts"
  chart      = "aws-load-balancer-controller"
  namespace  = "kube-system"
  version    = "1.7.1" # 请根据需要选择版本

  set {
    name  = "clusterName"
    value = data.aws_eks_cluster.eks.name
  }

  set {
    name  = "serviceAccount.create"
    value = "true"
  }

  set {
    name  = "serviceAccount.name"
    value = "aws-load-balancer-controller"
  }

  set {
    name  = "serviceAccount.annotations.eks\\.amazonaws\\.com/role-arn"
    value = module.lb_controller_irsa.iam_role_arn
  }
}

# 输出 Target Group ARN 供 Kubernetes Manifest 使用
output "eks_target_group_arn" {
  value = aws_lb_target_group.eks_tg.arn
}
```

